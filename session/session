#!/bin/sh

export XDG_CURRENT_DESKTOP=dwm
export PATH="$HOME/.local/bin:$PATH"
unset WAYLAND_DISPLAY

case ":$XDG_DATA_DIRS:" in
*flatpak*) ;;
*) export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" ;;
esac

dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP

setxkbmap -layout us -option ''
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

xset s 600 600
xset dpms 900 900 900
xss-lock --transfer-sleep-lock -- i3lock --nofork -c 222222 &

wallpaper &
sxhkd &
picom &
slstatus &
dunst &
lxpolkit &
gammastep &
batmon &
automirror &
clipmenud &

# restart dwm only if it crashes; fall back to the last good build if it dies right away
DWM="$HOME/.local/bin/dwm"
while :; do
	start=$(date +%s)
	"$DWM" 2>>"$HOME/.cache/dwm.log" && break
	if [ $(( $(date +%s) - start )) -lt 5 ]; then
		DWM="$HOME/.local/bin/dwm.good"
		sleep 1
	fi
done

for p in clipmenud clipserve automirror batmon wallpaper sxhkd picom slstatus dunst lxpolkit gammastep xss-lock; do
	pkill -u "$(id -u)" -x "$p"
done
