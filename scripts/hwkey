#!/bin/sh

notify() {
	notify-send -a hwkey -u low -t 1500 -h "string:x-dunst-stack-tag:$1" \
		${3:+-h "int:value:$3"} "$2"
}

vol() {
	v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
	pct=$(echo "$v" | awk '{printf "%d", $2 * 100 + 0.5}')
	case $v in
	*MUTED*) notify vol "Volume: muted" "$pct" ;;
	*)       notify vol "Volume: $pct%" "$pct" ;;
	esac
}

bright() {
	pct=$(brightnessctl -m | cut -d, -f4 | tr -d %)
	notify bright "Brightness: $pct%" "$pct"
}

case $1 in
vol-up)      wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; vol ;;
vol-down)    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; vol ;;
vol-mute)    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; vol ;;
mic-mute)
	wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
	case $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@) in
	*MUTED*) notify mic "Mic: muted" ;;
	*)       notify mic "Mic: on" ;;
	esac ;;
bright-up)   brightnessctl -q set 5%+; bright ;;
bright-down) brightnessctl -q -n set 5%-; bright ;;
kb-next)
	case $(setxkbmap -query | awk '/^layout/ {print $2}') in
	us) new=br ;;
	*)  new=us ;;
	esac
	setxkbmap -layout "$new"
	[ -f "$HOME/.Xmodmap" ] && xmodmap "$HOME/.Xmodmap"
	notify kb "Keyboard: $new" ;;
*) echo "usage: $0 vol-up|vol-down|vol-mute|mic-mute|bright-up|bright-down|kb-next" >&2; exit 1 ;;
esac
