[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (10, 28)
    width = 300
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    frame_width = 1
    frame_color = "#829e8d"
    separator_color = frame
    padding = 8
    horizontal_padding = 10
    gap_size = 4
    font = monospace 10
    format = "<b>%s</b>\n%b"
    corner_radius = 0
    icon_position = off
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#bbbbbb"
    highlight = "#829e8d"
    timeout = 3

[urgency_normal]
    background = "#222222"
    foreground = "#bbbbbb"
    highlight = "#829e8d"
    timeout = 8

[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#cc6666"
    highlight = "#cc6666"
    timeout = 0

[hwkey]
    appname = hwkey
    format = "%s"
